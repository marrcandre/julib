# Copy ONLY to .github/workflows/backup.yml in the PRIVATE backup repository.
name: Private daily backup
run-name: Backup ${{ inputs.request_id || github.run_id }}
on:
  schedule:
    - cron: '23 6 * * *'
  workflow_dispatch:
    inputs:
      request_id:
        required: false
        type: string
permissions:
  contents: read
concurrency:
  group: backups
  cancel-in-progress: false
jobs:
  backup:
    if: github.event.repository.private == true
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          repository: marrcandre/julib
          ref: main
      - uses: astral-sh/setup-uv@v6
        with:
          python-version: '3.13'
      - run: uv sync --project backend --frozen --no-dev
      - name: Export and encrypt
        env:
          DATABASE_URL: ${{ secrets.BACKUP_DATABASE_URL }}
          BACKUP_DATABASE_URL: ${{ secrets.BACKUP_DATABASE_URL }}
          BACKUP_PUBLIC_KEY: ${{ secrets.BACKUP_PUBLIC_KEY }}
          CLOUDINARY_CLOUD_NAME: ${{ secrets.CLOUDINARY_CLOUD_NAME }}
          CLOUDINARY_API_KEY: ${{ secrets.CLOUDINARY_API_KEY }}
          CLOUDINARY_API_SECRET: ${{ secrets.CLOUDINARY_API_SECRET }}
          BACKUP_MAX_BYTES: '52428800'
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y postgresql-client
          printf '%s' "$BACKUP_PUBLIC_KEY" > /tmp/backup-public.pem
          uv run --project backend python backend/manage.py cleanup_imports
          uv run --project backend python scripts/backup.py create --public /tmp/backup-public.pem --output /tmp/julib-backup.enc --media
      - uses: actions/upload-artifact@v4
        with:
          name: julib-backup-${{ github.run_id }}
          path: /tmp/julib-backup.enc
          retention-days: 7
          if-no-files-found: error
