# Copy ONLY to .github/workflows/backup.yml in the PRIVATE backup repository.
# Manual dispatch only. Enabling or running this workflow requires explicit approval.
name: Private manual backup
run-name: Backup ${{ inputs.request_id || github.run_id }}
on:
  workflow_dispatch:
    inputs:
      request_id:
        required: false
        type: string
permissions:
  contents: read
concurrency:
  group: backups
  cancel-in-progress: false
jobs:
  backup:
    if: github.event.repository.private == true
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          repository: marrcandre/julib
          ref: main
      - uses: astral-sh/setup-uv@v6
        with:
          python-version: '3.13'
      - run: uv sync --project backend --frozen --no-dev
      - name: PostgreSQL 17 dump client
        run: |
          docker pull postgres:17-alpine
          mkdir -p /tmp/julib-bin
          cat > /tmp/julib-bin/pg_dump <<'SH'
          #!/usr/bin/env bash
          set -euo pipefail
          : "${PGPASSFILE:?PGPASSFILE is required}"
          exec docker run --rm --network host \
            -v "$PGPASSFILE:$PGPASSFILE:ro" \
            -e PGPASSFILE -e PGOPTIONS \
            postgres:17-alpine pg_dump "$@"
          SH
          chmod +x /tmp/julib-bin/pg_dump
          echo /tmp/julib-bin >> "$GITHUB_PATH"
      - name: Export and encrypt
        env:
          DATABASE_URL: ${{ secrets.BACKUP_DATABASE_URL }}
          BACKUP_DATABASE_URL: ${{ secrets.BACKUP_DATABASE_URL }}
          BACKUP_PUBLIC_KEY: ${{ secrets.BACKUP_PUBLIC_KEY }}
          CLOUDINARY_URL: ${{ secrets.CLOUDINARY_URL }}
          BACKUP_MAX_BYTES: '52428800'
        run: |
          set -euo pipefail
          umask 077
          backup_dir="$RUNNER_TEMP/julib-backup-$GITHUB_RUN_ID"
          install -d -m 700 "$backup_dir"
          public_key="$backup_dir/public.pem"
          cleanup_export() {
            result=$?
            rm -f -- "$public_key"
            if (( result != 0 )); then rm -rf -- "$backup_dir"; fi
            exit "$result"
          }
          trap cleanup_export EXIT
          printf '%s' "$BACKUP_PUBLIC_KEY" > "$public_key"
          backup_file="julib-backup-$GITHUB_RUN_ID.enc"
          uv run --project backend python scripts/backup.py create --public "$public_key" --output "$backup_dir/$backup_file" --media
          cd "$backup_dir"
          sha256sum "$backup_file" > "$backup_file.sha256"
      - uses: actions/upload-artifact@v4
        with:
          name: julib-backup-${{ github.run_id }}
          path: |
            ${{ runner.temp }}/julib-backup-${{ github.run_id }}/julib-backup-*.enc
            ${{ runner.temp }}/julib-backup-${{ github.run_id }}/julib-backup-*.enc.sha256
          retention-days: 30
          if-no-files-found: error
      - name: Remove local backup files
        if: always()
        env:
          BACKUP_DIR: ${{ runner.temp }}/julib-backup-${{ github.run_id }}
        run: rm -rf -- "$BACKUP_DIR"
